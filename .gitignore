# Widget Preview related
.widget_preview/

# Firebase: a `flutterfire configure` által legenerált, projektspecifikus
# fájlok. Helyben kellenek a futáshoz, de nem mennek gitre, mert
# API-kulcsokat tartalmaznak. Új gépen: `flutterfire configure`,
# vagy másold be a Firebase konzolról letöltött fájlokat ugyanide.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
firebase.json

# Meta AI kulcs és mintája: soha nem megy gitre.
.env
.env.json
.env.example

# Android release-aláírás: a keystore és a jelszavai soha nem mennek gitre.
android/key.properties
android/app/*.jks
android/app/*.keystore

# Belső feljegyzések: helyi segédletek, soha nem mennek gitre, mert
# személyes / projektspecifikus adatot tartalmaznak (iskola, lakhely,
# projekt-azonosítók). A fájlok a gépen maradnak, csak a git nem látja őket.
MEMORY.md
FIREBASE_SETUP.md
docs/

# Távoli segéd cuccai: képernyőképek, csatolmányok, soha nem mennek gitre.
.muse_remote_attachments/
