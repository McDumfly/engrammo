# Firebase: a `flutterfire configure` által legenerált, projektspecifikus
# fájlok. Helyben kellenek a futáshoz, de nem mennek gitre, mert
# API-kulcsokat tartalmaznak. Új gépen: `flutterfire configure`,
# vagy másold be a Firebase konzolról letöltött fájlokat ugyanide.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart
firebase.json

# Firestore-szabály és projekt-azonosító: helyi deploy-segédlet,
# soha nem megy gitre. A fájlok a gépen maradnak.
firestore.rules
.firebaserc

# Meta AI kulcs: soha nem megy gitre. A `.env.example` minta (üres kulccsal)
# szándékosan git alatt van, hogy a klónozók lássák a formátumot.
.env
.env.json

# Android release-aláírás: a keystore és a jelszavai soha nem mennek gitre.
android/key.properties
android/app/*.jks
android/app/*.keystore

# Belső feljegyzés: személyes adatot tartalmazhat,
